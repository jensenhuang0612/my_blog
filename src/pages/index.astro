---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

posts.sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const latestPosts = posts.slice(0, 3);
---

<Layout
  title="JENSEN — Technology · Homelab · Networking · Security · AI"
  description="JENSEN 的个人技术博客，记录 Linux、Homelab、Networking、Security、AI 等技术实践。"
>
  <div class="container">

    <section class="hero">
      <p class="eyebrow">
        TECHNOLOGY · HOMELAB · NETWORKING · SECURITY · AI
      </p>

      <h1>JENSEN</h1>

      <p class="hero-subtitle">Independent technology
        & infrastructure notes.</p>

      <p class="intro">
        记录技术实践、实验过程与踩坑经历。
        <br />
        把解决过的问题留下来。
      </p>

      <div class="actions">
        <a href="/posts/" class="button primary">
          阅读文章
        </a>

        <a href="/projects/" class="button">
          查看项目
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">LATEST</p>
          <h2>最新文章</h2>
        </div>

        <a href="/posts/" class="more">
          查看全部 →
        </a>
      </div>

      {
        latestPosts.length > 0 ? (
          <div class="post-list">
            {latestPosts.map((post) => (
              <a
                href={`/posts/${post.id}/`}
                class="post"
              >
                <div class="post-info">
                  <span>{post.data.category}</span>

                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("zh-CN")}
                  </time>
                </div>

                <h3>{post.data.title}</h3>

                <p>
                  {post.data.description}
                </p>

                <div class="tags">
                  {post.data.tags.map((tag) => (
                    <span>#{tag}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">
            暂无文章。
          </p>
        )
      }
    </section>

    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">PROJECTS</p>
          <h2>项目方向</h2>
        </div>
      </div>

      <div class="project-grid">
        <a href="/projects/" class="project">
          <span>01</span>
          <h3>Homelab</h3>
          <p>
            NAS、服务器、Docker、虚拟化与家庭基础设施。
          </p>
        </a>

        <a href="/projects/" class="project">
          <span>02</span>
          <h3>Networking</h3>
          <p>
            网络架构、代理、隧道、DNS 与各种网络实验。
          </p>
        </a>

        <a href="/projects/" class="project">
          <span>03</span>
          <h3>Security</h3>
          <p>
            信息安全、防御、系统安全与安全实践。
          </p>
        </a>

        <a href="/projects/" class="project">
          <span>04</span>
          <h3>AI</h3>
          <p>
            AI、模型、API、自动化与本地 AI 实践。
          </p>
        </a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .hero {
    padding: 112px 0 96px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .hero h1 {
    margin: 18px 0 0;
    font-size: clamp(4rem, 10vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.08em;
  }

  .hero-subtitle {
    max-width: 700px;
    margin: 28px 0 0;
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 620px;
    margin: 34px 0 0;
    color: var(--muted);
    font-size: 1.08rem;
  }

  .actions {
    display: flex;
    gap: 12px;
    margin-top: 36px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--border);
    font-size: 0.9rem;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .button:hover,
  .button.primary {
    background: var(--text);
    color: var(--inverse-text);
  }

  .section {
    padding: 90px 0;
    border-bottom: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 40px;
  }

  .section-header h2 {
    margin: 10px 0 0;
    font-size: 1.8rem;
    letter-spacing: -0.05em;
  }

  .more {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .more:hover {
    color: var(--text);
  }

  .post-list {
    border-top: 1px solid var(--border);
  }

  .post {
    display: block;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .post {
    transition: padding-left 0.15s ease;
  }

  .post:hover {
    padding-left: 6px;
  }

  .post:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-info {
    display: flex;
    gap: 16px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .post h3 {
    margin: 5px 0 3px;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }

  .post p {
    margin: 0;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .empty {
    color: var(--muted);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .project {
    min-height: 120px;
    padding: 16px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .project:hover {
    background: var(--surface-hover);
  }

  .project {
    transition:
      background 0.15s ease,
      padding-left 0.15s ease;
  }

  .project:hover {
    padding-left: 20px;
  }

  .project > span {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .project h3 {
    margin: 18px 0 6px;
    font-size: 1.2rem;
  }

  .project p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .hero {
      padding: 76px 0;
    }

    .section {
      padding: 65px 0;
    }

    .section-header {
      align-items: start;
      gap: 20px;
      flex-direction: column;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
