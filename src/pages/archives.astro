---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

posts.sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);

const archives = new Map<
  number,
  typeof posts
>();

for (const post of posts) {
  const year = post.data.date.getFullYear();

  if (!archives.has(year)) {
    archives.set(year, []);
  }

  archives.get(year)!.push(post);
}
---

<Layout
  title="归档 — JENSEN"
  description="JENSEN 技术博客文章归档。"
>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">ARCHIVES</p>

      <h1>归档</h1>

      <p class="intro">
        按时间整理所有文章。
        <br />
        记录每一次技术实践。
      </p>
    </header>

    <section class="archive">
      {
        Array.from(archives.entries()).map(
          ([year, yearPosts]) => (
            <div class="year">
              <h2>{year}</h2>

              <div class="posts">
                {
                  yearPosts.map((post) => (
                    <a
                      href={`/posts/${post.id}/`}
                      class="post"
                    >
                      <time
                        datetime={post.data.date.toISOString()}
                      >
                        {post.data.date.toLocaleDateString(
                          "zh-CN",
                          {
                            month: "2-digit",
                            day: "2-digit",
                          },
                        )}
                      </time>

                      <div class="post-content">
                        <h3>{post.data.title}</h3>

                        <p>
                          {post.data.description}
                        </p>
                      </div>

                      <span class="category">
                        {post.data.category}
                      </span>

                      <span class="arrow">→</span>
                    </a>
                  ))
                }
              </div>
            </div>
          ),
        )
      }
    </section>

    <section class="summary">
      <span>{posts.length}</span>

      <p>
        {posts.length === 1
          ? "篇文章，记录从这里开始。"
          : "篇文章，持续记录中。"}
      </p>
    </section>
  </div>
</Layout>

<style>
  .page-header {
    padding: 100px 0 80px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .page-header h1 {
    margin: 14px 0 0;
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.08em;
  }

  .intro {
    max-width: 600px;
    margin: 32px 0 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .archive {
    padding: 20px 0 0;
  }

  .year {
    display: grid;
    grid-template-columns: 140px 1fr;
    border-bottom: 1px solid var(--border);
  }

  .year > h2 {
    margin: 0;
    padding: 42px 0;
    font-size: 2rem;
    letter-spacing: -0.05em;
  }

  .posts {
    border-left: 1px solid var(--border);
  }

  .post {
    display: grid;
    grid-template-columns: 70px 1fr auto 30px;
    gap: 20px;
    align-items: center;

    padding: 28px 20px;

    border-bottom: 1px solid var(--border);

    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .post:last-child {
    border-bottom: 0;
  }

  .post:is(:hover, :focus-visible) {
    background: var(--surface-hover);
    transform: translateX(8px);
  }

  /* Dark mode: same selected effect as Projects */
  :global(html.dark) .post:is(:hover, :focus-visible) {
    background: var(--surface-hover);
    transform: translateX(8px);
  }

  .post time {
    color: var(--muted);
    font-family:
      "JetBrains Mono",
      Consolas,
      monospace;
    font-size: 0.75rem;
  }

  .post-content h3 {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .post-content p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .category {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .arrow {
    color: var(--muted);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
  }

  .post:is(:hover, :focus-visible) .arrow {
    color: var(--text);
    transform: translateX(4px);
  }

  .summary {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 70px 0 100px;
  }

  .summary span {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.06em;
  }

  .summary p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .page-header {
      padding: 80px 0 60px;
    }

    .year {
      display: block;
    }

    .year > h2 {
      padding: 35px 0 20px;
    }

    .posts {
      border-left: 0;
    }

    .post {
      grid-template-columns: 55px 1fr 24px;
      gap: 14px;
      padding: 24px 0;
    }

    .category {
      display: none;
    }

    .post-content p {
      display: none;
    }

    .post:is(:hover, :focus-visible) {
      transform: translateX(4px);
    }
  }
</style>

