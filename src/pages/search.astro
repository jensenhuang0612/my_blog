---
import Layout from "../layouts/Layout.astro";
---

<Layout title="搜索 — JENSEN" description="搜索 JENSEN 技术博客">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">SEARCH</p>
      <h1>搜索</h1>
      <p>搜索博客中的文章、技术内容和实践记录。</p>
    </header>

    <section class="search-section">
      <div class="search-box">
        <input id="search-input" type="search" placeholder="搜索文章……" autocomplete="off" />
      </div>
      <div id="search-results"></div>
    </section>
  </div>
</Layout>

<script is:inline>
  let pagefind;

  const input = document.querySelector("#search-input");
  const results = document.querySelector("#search-results");

  async function init() {
    try {
      pagefind = await import("/pagefind/pagefind.js");

      input?.addEventListener("input", async () => {
        const query = input.value.trim();

        if (!results) return;

        if (!query) {
          results.innerHTML = "";
          return;
        }

        const search = await pagefind.search(query);

        if (!search.results.length) {
          results.innerHTML = '<p class="empty">没有找到相关内容。</p>';
          return;
        }

        const items = await Promise.all(
          search.results.map((result) => result.data())
        );

        results.innerHTML = items.map((item) => `
          <a class="result" href="${item.url}">
            <h2>${item.meta?.title ?? "未命名文章"}</h2>
            <p>${item.excerpt ?? ""}</p>
          </a>
        `).join("");
      });
    } catch (error) {
      console.error("Pagefind 加载失败:", error);

      if (results) {
        results.innerHTML = '<p class="empty">搜索索引未加载，请先运行 npm run build。</p>';
      }
    }
  }

  init();
</script>

<style>
  .page-header {
    padding: 100px 0 70px;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 12px 0 0;
    font-size: 4rem;
    letter-spacing: -0.06em;
  }

  .page-header > p:last-child {
    max-width: 600px;
    margin-top: 20px;
    color: var(--muted);
  }

  .search-section {
    padding: 60px 0 100px;
  }

  .search-box,
  #search-results {
    max-width: 800px;
  }

  #search-input {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    font-size: 1rem;
    outline: none;
  }

  #search-input:focus {
    border-color: var(--text);
  }

  #search-results {
    margin-top: 32px;
  }

  .result {
    display: block;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    transition: padding-left 0.15s ease;
  }

  .result:hover {
    padding-left: 6px;
  }

  .result h2 {
    margin: 0 0 5px;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .result p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .empty {
    padding: 20px 0;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .page-header {
      padding: 80px 0 50px;
    }

    h1 {
      font-size: 3rem;
    }

    .search-section {
      padding-top: 40px;
    }
  }
</style>