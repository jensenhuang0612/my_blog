---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

posts.sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="文章 — JENSEN"
  description="JENSEN 的技术文章"
>
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">BLOG</p>

      <h1>文章</h1>

      <p>
        Linux、Homelab、Networking、Security、AI
        以及各种技术实践。
      </p>
    </header>

    <section class="post-list">
      {
        posts.map((post) => (
          <a
            href={`/posts/${post.id}/`}
            class="post"
          >
            <div class="post-info">
              <span>{post.data.category}</span>

              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("zh-CN")}
              </time>
            </div>

            <h2>{post.data.title}</h2>

            <p>{post.data.description}</p>

            <div class="tags">
              {
                post.data.tags.map((tag) => (
                  <span>#{tag}</span>
                ))
              }
            </div>
          </a>
        ))
      }
    </section>
  </div>
</Layout>

<style>
  .page-header {
    padding: 100px 0 70px;

    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0;

    color: var(--muted);

    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 12px 0 0;

    font-size: 4rem;
    letter-spacing: -0.06em;
  }

  .page-header > p:last-child {
    max-width: 600px;

    margin-top: 20px;

    color: var(--muted);
  }

  .post-list {
    border-bottom: 1px solid var(--border);
  }

  .post {
    display: block;

    padding: 40px 0;

    border-bottom: 1px solid var(--border);
  }

  .post:last-child {
    border-bottom: 0;
  }

  .post:hover h2 {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .post-info {
    display: flex;
    gap: 16px;

    color: var(--muted);

    font-size: 0.8rem;
  }

  .post h2 {
    margin: 12px 0 8px;

    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }

  .post p {
    margin: 0;

    color: var(--muted);
  }

  .tags {
    display: flex;
    gap: 10px;

    margin-top: 16px;

    color: var(--muted);

    font-size: 0.8rem;
  }
</style>